# Knarr — API Keys
# Copy this to .env and fill in your keys:
#   cp .env.example .env
#
# Knarr auto-detects which providers are available.
# Only set the ones you want to use.
# Each provider also has a LANGERTHA_<NAME>_API_KEY variant
# (LANGERTHA_OPENAI_API_KEY), which wins over the bare name.

# LLM Providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
#GROQ_API_KEY=
#MISTRAL_API_KEY=
#DEEPSEEK_API_KEY=
#MINIMAX_API_KEY=
#CEREBRAS_API_KEY=
#OPENROUTER_API_KEY=
#PERPLEXITY_API_KEY=
#GEMINI_API_KEY=
#XAI_API_KEY=
#MOONSHOT_API_KEY=
#NOUSRESEARCH_API_KEY=
#AKI_API_KEY=
#SCALEWAY_API_KEY=
#TSYSTEMS_API_KEY=
# Hetzner only with the prefix (bare HETZNER_API_KEY is the Cloud API key)
#LANGERTHA_HETZNER_API_KEY=
# Replicate and HuggingFace have no default model: configure one in a
# config file (knarr init writes an entry without model:)
#REPLICATE_API_TOKEN=
#HUGGINGFACE_API_KEY=

# Langfuse Tracing (optional — enables automatic observability)
# With docker compose: create a project at http://localhost:3000 first and
# put its keys here, then restart knarr.
#LANGFUSE_PUBLIC_KEY=pk-lf-...
#LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_URL is set to http://langfuse:3000 in docker-compose.yml
#LANGFUSE_URL=https://cloud.langfuse.com
#KNARR_TRACE_NAME=knarr-proxy

# Proxy Authentication (optional — protects your proxy)
#KNARR_API_KEY=

# Request logging (optional)
#KNARR_LOG_FILE=/tmp/knarr-requests.jsonl
#KNARR_LOG_DIR=/tmp/knarr-requests

# Public base URL for /.well-known/langertha.json (optional)
#KNARR_PUBLIC_URL=https://knarr.example

# Upstream timeouts in seconds, 0 disables (defaults shown)
#KNARR_UPSTREAM_TIMEOUT=300
#KNARR_UPSTREAM_STALL_TIMEOUT=120

# Startup capability probe of gateway / self-hosted engines (defaults shown)
#KNARR_PROBE_CAPABILITIES=1
#KNARR_PROBE_TIMEOUT=10

# Worker processes on the same listen sockets; knarr start -w wins (default shown)
#KNARR_WORKERS=1

# A2A agent card at /.well-known/agent.json (defaults shown)
#KNARR_A2A_NAME="Langertha Knarr Agent"
#KNARR_A2A_DESCRIPTION="LLM agent served through Langertha Knarr"

# Ollama version reported at GET /api/version (x.y.z only)
#KNARR_OLLAMA_COMPAT_VERSION=0.34.4

# Verbose logging to stderr
#KNARR_DEBUG=1
